
API_SECRET_KEY=change-me-to-a-long-random-string


ENCRYPTION_KEY=change-me-generate-a-fernet-key

FRONTEND_ORIGIN=http://localhost:5173

#
LLM_PROVIDER=mock

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash


#         this app can NEVER send email, by design; see README "Security")
EMAIL_SOURCE=mock

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/auth/gmail/callback
GMAIL_WATCH_LABEL=TaskPilot

# --- Agent behavior ----------------------------------------------------------
CONFIDENCE_THRESHOLD=0.7
POLL_INTERVAL_SECONDS=60
MAX_RETRIES=1

# --- Storage -----------------------------------------------------------------
DATABASE_PATH=./taskpilot.db
